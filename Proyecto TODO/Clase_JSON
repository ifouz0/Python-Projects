import json
from Clase_Project import Proyecto

class GestorProyectos:
    def __init__(self):
        self.archivo = "todo.json"
        self.proyectos = []

    def guardar_proyectos(self, proyectos):
        with open(self.archivo, 'w') as file:
            for proyecto in proyectos:
                json.dump(proyecto)
            json.dump(proyectos, file, default=Proyecto.to_dict)
    
    def cargar_proyectos(self):

        return proyectos
 